# ==========================================
# Configuración del Backend + Keycloak + PostgreSQL
# ==========================================

PROJECT_NAME="Ecosistema Herramienta GIS - Backend"
VERSION="2.0.0"
API_V1_STR="/api"

# Keycloak Server Configuration (mismo realm/cliente que idec-erp-front y las apps móviles)
KEYCLOAK_URL="https://auth.catastrocbba.com"
KEYCLOAK_REALM="alcaldia-idec"
KEYCLOAK_CLIENT_ID="app-idec"
KEYCLOAK_CLIENT_SECRET=""
KEYCLOAK_TIMEOUT_SECONDS=20

# CORS Frontend Origin (Vite dev server — ver Guía §3.2)
FRONTEND_ORIGIN="http://localhost:8060"

# PostgreSQL Database Configuration
DB_HOST="localhost"
DB_PORT="5432"
DB_USER="postgres"
DB_PASSWORD="tu_password_aqui"
DB_NAME="idec_erp"

# O URL completa de conexión directa:
# DATABASE_URL="postgresql://postgres:tu_password_aqui@localhost:5432/idec_erp"

# Construction detection GPU engine (BFF only — engine stays on 10.0.0.30)
DETECTION_ENGINE_URL="http://10.0.0.30:8100"
DETECTION_ENGINE_API_KEY=""
DETECTION_ENGINE_TIMEOUT_SECONDS=120

# Zentyal (LDAP/Samba4 AD-DC) — institutional directory integration, opcional
ZENTYAL_LDAP_HOST=""
ZENTYAL_LDAP_PORT=636
ZENTYAL_LDAP_USE_SSL=true
ZENTYAL_LDAP_VERIFY_CERT=false
ZENTYAL_LDAP_BIND_DN=""
ZENTYAL_LDAP_BIND_PASSWORD=""
ZENTYAL_LDAP_SEARCH_BASE_DN="dc=catastrocbba,dc=com"
ZENTYAL_LDAP_USER_SEARCH_FILTER="(sAMAccountName={username})"
ZENTYAL_LDAP_TIMEOUT_SECONDS=10
