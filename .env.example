# ==========================================
# Configuración del Backend + Keycloak + PostgreSQL
# ==========================================
#
# PLANTILLA. Este archivo SÍ se versiona, así que no debe contener ningún valor
# real: ni contraseñas, ni secretos de cliente, ni hosts internos. Copialo a
# `.env` (que está en .gitignore) y rellená ahí los valores de verdad.
#
#     cp .env.example .env
#
# Los valores reales se piden al responsable de infraestructura; no se pasan por
# el repositorio ni por chat.

PROJECT_NAME="Ecosistema Herramienta GIS - Backend"
VERSION="2.0.0"
API_V1_STR="/api"

# Keycloak Server Configuration
KEYCLOAK_URL="https://auth.catastrocbba.com"
KEYCLOAK_REALM="alcaldia-idec"
KEYCLOAK_CLIENT_ID="app-idec"
# Credencial del cliente confidencial en Keycloak: Clients -> app-idec -> Credentials
KEYCLOAK_CLIENT_SECRET="<pedir-a-infraestructura>"
KEYCLOAK_TIMEOUT_SECONDS=20

# CORS Frontend Origin (lista separada por comas)
FRONTEND_ORIGIN="http://localhost:8060"

# PostgreSQL Database Configuration
DB_HOST="localhost"
DB_PORT="5432"
DB_USER="<usuario-bd>"
DB_PASSWORD="<password-bd>"
DB_NAME="idec_erp"

# Construction detection GPU engine (BFF only — el motor vive en su propio host)
DETECTION_ENGINE_URL="http://<host-motor-gpu>:8100"
DETECTION_ENGINE_API_KEY=""
DETECTION_ENGINE_TIMEOUT_SECONDS=120

# O URL completa de conexión directa:
# DATABASE_URL="postgresql://<usuario>:<password>@<host>:5432/idec_erp"

CHATBOT_OLLAMA_URL="http://<host-ollama>:11434"
CHATBOT_CHAT_MODEL="gemma4:e4b"
CHATBOT_VISION_MODEL="qwen3-vl:4b"
CHATBOT_EMBEDDING_MODEL="nomic-embed-text"
CHATBOT_CHAT_TIMEOUT_SECONDS=120
CHATBOT_VISION_TIMEOUT_SECONDS=180
CHATBOT_EMBEDDING_TIMEOUT_SECONDS=60
CHATBOT_MATCH_THRESHOLD=0.50
CHATBOT_TESSERACT_CMD=""
CHATBOT_TESSERACT_LANG="spa"

# Folios domain (Escaneo Folios / Detección de Folios) — servicio OCR GAMC
# llamado desde el backend (el servidor tiene que poder llegar a esta URL) y,
# opcional, un Ollama que solo completa asientos de la columna A que las reglas
# no pudieron leer: vacío = solo reglas.
FOLIOS_OCR_API_URL="https://ocr.catastrocbba.com"
FOLIOS_OCR_TIMEOUT_SECONDS=90
FOLIOS_OCR_POLL_INTERVAL_SECONDS=1.5
FOLIOS_CONFIDENCE_THRESHOLD=0.85
FOLIOS_OLLAMA_URL=""
FOLIOS_LLM_MODEL="gemma4:e4b"
FOLIOS_LLM_TIMEOUT_SECONDS=120

# Digitization domain — PCs de los arquitectos que corren Ollama. Se leen con
# prefijo DIGITIZATION_ (ver domains/digitization/infrastructure/config.py);
# los valores de abajo son los defaults del código, solo hace falta ponerlos
# aquí para cambiarlos. Vacío = la cola queda encolada sin despachar.
DIGITIZATION_WORKER_URLS=""
# false en copias locales, para que solo el servidor desplegado despache trabajos.
DIGITIZATION_DISPATCHER_ENABLED=true
DIGITIZATION_VISION_MODEL="qwen3-vl:4b"
DIGITIZATION_REQUEST_TIMEOUT_SECONDS=600
DIGITIZATION_MAX_ATTEMPTS=3
DIGITIZATION_MAX_UPLOAD_MB=20

# Folder analysis, carril de comprobantes de pago (FUR). El modelo es el de
# visión que las PCs de los arquitectos ya tienen cargado; TAX_RECEIPT_OLLAMA_URL
# es solo el fallback cuando ninguna PC lo tiene. Vacío apaga la pasada y deja
# el carril con sus reglas solas.
TAX_RECEIPT_CONFIDENCE_THRESHOLD=0.85
TAX_RECEIPT_OLLAMA_URL=""
TAX_RECEIPT_LLM_MODEL="qwen3-vl:4b"
TAX_RECEIPT_LLM_TIMEOUT_SECONDS=45
TAX_RECEIPT_LLM_MAX_TOKENS=1024

# Folder analysis, última pasada de la lectura: el modelo de visión MIRANDO la
# foto, para los datos que el texto de la hoja no sabe distinguir -- el número
# del notario está en un sello redondo y al lado va impresa la "Resolución
# Ministerial Nº 57/2020", que como texto se lee igual. Corre en las mismas PCs
# de los arquitectos; FOLDER_VISION_OLLAMA_URL es solo el fallback. Mirar una
# foto le toma 20-30 s. Modelo vacío apaga la pasada.
FOLDER_VISION_OLLAMA_URL=""
FOLDER_VISION_MODEL="qwen3-vl:4b"
FOLDER_VISION_TIMEOUT_SECONDS=60
FOLDER_VISION_MAX_PAGES=3

# Appraisal review — BD del sistema de Avalúos (servidor y login aparte de idec_erp)
AVALUOS_DB_HOST="localhost"
AVALUOS_DB_PORT="5432"
AVALUOS_DB_USER="<usuario-bd-avaluos>"
AVALUOS_DB_PASSWORD="<password-bd-avaluos>"
AVALUOS_DB_NAME="catastro_operativo"

# Reportes domain (reporte gerencial de trámites) — SQL Server aparte.
# Windows: ODBC Driver 17/18 for SQL Server. Linux: FreeTDS (apt: unixodbc freetds-bin tdsodbc).
REPORTS_DB_SERVER="<host-sqlserver>,1433"
REPORTS_DB_NAME="catastro"
REPORTS_DB_USER="<usuario-sqlserver>"
REPORTS_DB_PASSWORD="<password-sqlserver>"
REPORTS_DB_DRIVER="ODBC Driver 17 for SQL Server"
# REPORTS_DB_DRIVER="FreeTDS"
# REPORTS_DB_TDS_VERSION="7.4"
UNIDAD_ID=102116
UNIDAD_NOMBRE="AREA TECNICA CARTOGRAFIA"
COMUNA_CENTRAL_ID=7

# Zentyal (LDAP/Samba4 AD-DC) — directorio institucional.
# OJO: la cuenta de bind puede reescribir el unicodePwd de cualquier usuario del
# dominio. Usá una cuenta de servicio con solo ese permiso delegado, nunca el
# Administrator del dominio.
ZENTYAL_LDAP_HOST="<host-zentyal>"
ZENTYAL_LDAP_PORT=636
ZENTYAL_LDAP_USE_SSL=true
ZENTYAL_LDAP_VERIFY_CERT=false
ZENTYAL_LDAP_BIND_DN="<cuenta-servicio>@catastrocbba.com"
ZENTYAL_LDAP_BIND_PASSWORD="<password-cuenta-servicio>"
ZENTYAL_LDAP_SEARCH_BASE_DN="dc=catastrocbba,dc=com"
ZENTYAL_LDAP_USER_SEARCH_FILTER="(sAMAccountName={username})"
ZENTYAL_LDAP_TIMEOUT_SECONDS=10
